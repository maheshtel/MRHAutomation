{
  "name": "appium-xcuitest-driver",
  "version": "12.22.8",
  "description": "Appium driver for iOS using XCUITest for backend",
  "keywords": [
    "appium",
    "ios",
    "webdriveragent",
    "xctest",
    "xcuitest"
  ],
  "bugs": {
    "url": "https://github.com/appium/appium-xcuitest-driver/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/appium-xcuitest-driver.git"
  },
  "bin": {},
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "scripts",
    "!scripts/ci/**",
    "build/lib",
    "!.DS_Store",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "import": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@appium/css-locator-to-native": "1.0.7",
    "@appium/strongbox": "2.0.1",
    "@colors/colors": "1.6.1",
    "appium-ios-device": "3.1.26",
    "appium-ios-simulator": "10.10.0",
    "appium-remote-debugger": "17.7.13",
    "appium-webdriveragent": "16.17.7",
    "appium-xcode": "7.2.4",
    "async-lock": "1.4.1",
    "asyncbox": "6.5.0",
    "axios": "1.21.0",
    "commander": "14.0.3",
    "dayjs": "1.11.23",
    "js2xmlparser2": "0.2.0",
    "lru-cache": "11.5.3",
    "node-devicectl": "2.2.2",
    "portscanner": "2.2.0",
    "semver": "7.8.5",
    "teen_process": "4.2.1",
    "winston": "3.19.0",
    "ws": "8.22.1"
  },
  "peerDependencies": {
    "appium": "^3.0.0-rc.2"
  },
  "optionalDependencies": {
    "appium-ios-remotexpc": "5.28.6",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "appium": {
    "driverName": "xcuitest",
    "automationName": "XCUITest",
    "platformNames": [
      "iOS",
      "tvOS",
      "watchOS"
    ],
    "mainClass": "XCUITestDriver",
    "scripts": {
      "build-wda": "./scripts/build-wda.mjs",
      "open-wda": "./scripts/open-wda.mjs",
      "tunnel-creation": "./scripts/tunnel-creation.mjs",
      "download-wda": "./scripts/download-wda.mjs",
      "download-wda-sim": "./scripts/download-wda-sim.mjs",
      "sign-wda": "./scripts/sign-wda.mjs",
      "image-mounter": "./scripts/image-mounter.mjs",
      "list-real-devices": "./scripts/list-real-devices.mjs",
      "cleanup-videos": "./scripts/cleanup-videos.mjs",
      "pair-appletv": "./scripts/pair-appletv.mjs"
    },
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema",
      "type": "object",
      "properties": {
        "webdriveragent-port": {
          "appiumCliDest": "wdaLocalPort",
          "default": 8100,
          "description": "Local port used for communication with WebDriverAgent",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "title": "XCUITest Driver Configuration",
      "description": "Appium configuration schema for the XCUITest driver."
    },
    "doctor": {
      "checks": [
        "./build/lib/doctor/required-checks.js",
        "./build/lib/doctor/optional-checks.js"
      ]
    }
  },
  "bundleDependencies": [
    "@appium/css-locator-to-native",
    "@appium/strongbox",
    "@colors/colors",
    "appium-ios-device",
    "appium-ios-simulator",
    "appium-remote-debugger",
    "appium-webdriveragent",
    "appium-xcode",
    "async-lock",
    "asyncbox",
    "axios",
    "commander",
    "dayjs",
    "js2xmlparser2",
    "lru-cache",
    "node-devicectl",
    "portscanner",
    "semver",
    "teen_process",
    "winston",
    "ws",
    "appium-ios-remotexpc"
  ]
}
