# ─────────────────────────────────────────────────────────────────────────────
# MRH StoreFront — Appium E2E configuration
# Copy to `.env` (gitignored) and fill in. Every value can also be supplied as
# a real environment variable (CI), which takes precedence over this file.
# Use ENV_FILE=.env.ci (or any path) to load a different file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Test account ────────────────────────────────────────────────────────────
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ── Test data ───────────────────────────────────────────────────────────────
# Term typed into search for the cart, quantity and wishlist scenarios. Must
# return at least one in-stock product in the search typeahead.
SEARCH_TERM=lavender
# A coupon code the store will reject (Quantity & Promotions scenario).
INVALID_COUPON_CODE=E2E-NOT-A-REAL-CODE

# ── App under test ──────────────────────────────────────────────────────────
# Leave APP_PATH empty to drive an app that is already installed on the device.
# Otherwise point at an .apk (Android), a simulator .app/.zip, or an .ipa
# (iOS real device). Relative paths resolve from the e2e-appium folder.
ANDROID_APP_PATH=
IOS_APP_PATH=
APP_PACKAGE=com.mrh.mobilestore
APP_ACTIVITY=.MainActivity
IOS_BUNDLE_ID=com.mrh.mobilestore

# true  = clear app data at the start of every spec file (recommended)
# false = keep the existing app state (faster local debugging)
FRESH_APP_STATE=true

# ── Android ─────────────────────────────────────────────────────────────────
# emulator | real
ANDROID_DEVICE_TYPE=emulator
ANDROID_DEVICE_NAME=Android Emulator
# Required for a real device or when several devices are attached
# (`adb devices`), e.g. emulator-5554 or R5CT1234ABC.
ANDROID_UDID=
# Optional. Name of an AVD Appium should boot if no emulator is running.
ANDROID_AVD=
ANDROID_PLATFORM_VERSION=

# ── iOS ─────────────────────────────────────────────────────────────────────
# simulator | real
IOS_DEVICE_TYPE=simulator
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=18.5
# Required for a real device (`xcrun xctrace list devices`). Optional for a
# simulator (pins one specific simulator).
IOS_UDID=
# Real device only — WebDriverAgent code signing.
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=Apple Development
IOS_UPDATED_WDA_BUNDLE_ID=
# Simulator speed-ups (the Azure iOS pipeline sets both):
# run without the Simulator window, and install a prebuilt WebDriverAgentRunner
# .app instead of compiling WDA (scripts/ci/prebuilt-wda.sh downloads one).
IOS_HEADLESS=false
IOS_PREBUILT_WDA_PATH=

# ── Appium server ───────────────────────────────────────────────────────────
# true  = WebdriverIO starts the project-local Appium server for the run
# false = connect to an already running server / grid / cloud at the URL below
START_APPIUM=true
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
APPIUM_PATH=/

# ── Execution ───────────────────────────────────────────────────────────────
# Default explicit wait for elements (ms)
WAIT_TIMEOUT=30000
# Upper bound for one attempt of one test (ms)
TEST_TIMEOUT=600000
# How many times a failing test is retried (the app is restarted before each
# retry). A test fails the run only if every attempt fails.
TEST_RETRIES=2
# Re-run a whole failing spec file in a brand-new session (device/driver crashes)
SPEC_FILE_RETRIES=0
# Parallel sessions. Keep 1 unless several devices are configured.
MAX_INSTANCES=1
# trace | debug | info | warn | error | silent
LOG_LEVEL=warn
# Record a screen video per test and attach it to failed tests (needs ffmpeg on iOS)
RECORD_VIDEO=false
