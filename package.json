{
  "name": "mrh-storefront-e2e-appium",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform (Android + iOS) Appium end-to-end suite for the MRH StoreFront app",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1"
  },
  "scripts": {
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "test:android:smoke": "wdio run ./config/wdio.android.conf.ts --suite smoke",
    "test:ios:smoke": "wdio run ./config/wdio.ios.conf.ts --suite smoke",
    "test:android:suite": "wdio run ./config/wdio.android.conf.ts --suite",
    "test:ios:suite": "wdio run ./config/wdio.ios.conf.ts --suite",
    "test:android:login": "wdio run ./config/wdio.android.conf.ts --suite login",
    "test:android:navigation": "wdio run ./config/wdio.android.conf.ts --suite navigation",
    "test:android:cart": "wdio run ./config/wdio.android.conf.ts --suite cart",
    "test:android:quantity-promotions": "wdio run ./config/wdio.android.conf.ts --suite quantity-promotions",
    "test:android:wishlist": "wdio run ./config/wdio.android.conf.ts --suite wishlist",
    "test:android:cleanup": "wdio run ./config/wdio.android.conf.ts --suite cleanup",
    "test:android:logout": "wdio run ./config/wdio.android.conf.ts --suite logout",
    "test:ios:login": "wdio run ./config/wdio.ios.conf.ts --suite login",
    "test:ios:navigation": "wdio run ./config/wdio.ios.conf.ts --suite navigation",
    "test:ios:cart": "wdio run ./config/wdio.ios.conf.ts --suite cart",
    "test:ios:quantity-promotions": "wdio run ./config/wdio.ios.conf.ts --suite quantity-promotions",
    "test:ios:wishlist": "wdio run ./config/wdio.ios.conf.ts --suite wishlist",
    "test:ios:cleanup": "wdio run ./config/wdio.ios.conf.ts --suite cleanup",
    "test:ios:logout": "wdio run ./config/wdio.ios.conf.ts --suite logout",
    "typecheck": "tsc --noEmit",
    "report": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "report:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "doctor:android": "appium driver doctor uiautomator2",
    "doctor:ios": "appium driver doctor xcuitest",
    "clean": "node -e \"for (const d of ['reports','logs']) require('fs').rmSync(d,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@wdio/allure-reporter": "10.2.0",
    "@wdio/appium-service": "10.2.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/junit-reporter": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@wdio/types": "10.2.0",
    "allure-commandline": "2.46.1",
    "appium": "3.9.0",
    "appium-uiautomator2-driver": "8.7.3",
    "appium-xcuitest-driver": "12.22.8",
    "dotenv": "18.0.10",
    "expect-webdriverio": "8.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "webdriverio": "10.2.0"
  }
}
